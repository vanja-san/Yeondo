<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Yeondo</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- LibraryImport требует AllowUnsafeBlocks для source generation -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- Иконка приложения -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

	<!-- Имя выходного файла без .App -->
	<AssemblyName>Yeondo</AssemblyName>
	
	<!-- Информация о приложении (для свойств файла) -->
	<AssemblyTitle>Yeondo - Symbolic Link Creator</AssemblyTitle>
	<AssemblyDescription>Утилита для массового создания символических ссылок (Symbolic/Junction/HardLink)</AssemblyDescription>
	<AssemblyCopyright>Copyright © 2026 vanja-san</AssemblyCopyright>
	<AssemblyCompany>vanja-san</AssemblyCompany>
	<AssemblyProduct>Yeondo</AssemblyProduct>

	<!-- Единственный источник версии. Значение по умолчанию используется при локальной сборке,
	     а -p:Version=... (global property) переопределяет его, поэтому AssemblyVersion/FileVersion/
	     InformationalVersion намеренно не задаются: SDK выводит их из Version сам. -->
    <Version Condition="'$(Version)' == ''">1.11.0</Version>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <Copyright>Copyright © 2026 vanja-san</Copyright>

    <!-- Лицензия проекта: Apache-2.0 — свободная, с явной защитой патентных требований. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Настройки для Debug -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Настройки для Release -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <StripSymbols>true</StripSymbols>
    
    <!-- Self-contained single-file публикация -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Файлы локализации поставляются вместе с приложением: пользователь может править их,
       а при повреждении сервис откатывается на встроенные английские значения. -->
  <ItemGroup>
    <Content Include="i18n\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Тесты обращаются к internal-хелперам MainViewModel (вывод имени ссылки, сравнение путей). -->
  <ItemGroup>
    <InternalsVisibleTo Include="yeondo-app.Tests" />
  </ItemGroup>

</Project>
